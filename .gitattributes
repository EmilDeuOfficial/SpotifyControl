# Normalize to LF in the repository, check out native on Windows.
* text=auto

# Must stay LF whatever the checkout platform: the shell refuses a script with CRLF endings.
gradlew text eol=lf
*.sh text eol=lf

# Windows-only, keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touched.
*.jar binary
*.png binary
*.ico binary
